{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-openrouter-provider",
  "version": "0.2.0",
  "description": "Select and hard-pin OpenRouter upstream providers from the OpenCode terminal or Desktop sidebar, with live pricing and performance metrics.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jackster/opencode-openrouter-provider.git"
  },
  "homepage": "https://github.com/Jackster/opencode-openrouter-provider#readme",
  "bugs": "https://github.com/Jackster/opencode-openrouter-provider/issues",
  "main": "./src/server.ts",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./server": {
      "import": "./src/server.ts",
      "config": {
        "refreshIntervalMs": "60000"
      }
    },
    "./tui": {
      "import": "./dist/tui.js",
      "config": {
        "refreshIntervalMs": "60000"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "test": "node --conditions=browser --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openrouter",
    "provider",
    "sidebar",
    "routing"
  ],
  "engines": {
    "opencode": ">=2.2.5"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": "*",
    "@opentui/keymap": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode/plugin": "^2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/keymap": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
